# Copy to .env.local and adjust for your setup.
# Required on a physical device — use your machine's LAN IP, not localhost.
# iOS simulator / web default to http://localhost:3000
# Android emulator defaults to http://10.0.2.2:3000
EXPO_PUBLIC_BETTER_AUTH_BASE_URL=http://localhost:3000

# Only needed if the backend's own BETTER_AUTH_BASE_URL isn't localhost:3000
# (e.g. it's running on a different port). This must match the backend's
# config exactly, NOT the address above — see src/lib/auth-client.ts.
# EXPO_PUBLIC_BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:3000

# Powers the AI Shopping Assistant (src/lib/ai-assistant.ts). Get a key at
# https://aistudio.google.com/apikey — use one scoped/rate-limited for this
# app, not a shared production key: it ships inside the compiled app bundle
# and can be extracted by anyone who inspects it. Without this set, the
# assistant screen shows a "not configured" state instead of crashing.
# EXPO_PUBLIC_GEMINI_API_KEY=
